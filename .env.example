# Agent Advisor — environment configuration template.
#
# Copy this file to `.env` and fill in the values that are empty.
# `.env` is gitignored so real secrets never land in git:
#
#     cp .env.example .env
#
# Every value in this file mirrors a default in src/config.py, which
# is the single place the two services read env vars from. Leaving
# a line commented out is equivalent to using the default.

# --- Persistence (paths are resolved relative to the project root) ---
PERSISTENCE_PATH="persistence"
VECTOR_DB_PATH="chroma"
KB_PATH="reference_files"
CHROMA_COLLECTION="financial-collection"

# --- Ollama models (must be pulled locally: `ollama pull <model>`) ---
TEXT_MODEL="llama3.2:latest"
EMBEDDING_MODEL="embeddinggemma:latest"

# --- Upstream APIs ---
# Free tier is fine: https://finnhub.io/register
# Required for /news, /earnings, and the news-fetching step of
# /assessment. Prices and RAG work without it, but the agent service
# will log a warning at boot if this is empty.
FINNHUB_API_KEY=""

# --- Inter-service ---
# Where the UI finds the agent. Default is correct for `python main.py`.
AGENT_BASE_URL="http://localhost:8011"
